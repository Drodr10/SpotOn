EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# LAN IP of the machine running the Flask backend, so a physical device or
# emulator can reach it (localhost resolves to the device itself). e.g. 192.168.1.42
EXPO_PUBLIC_IP=

# Google Maps SDK for Android key. Read by app.config.js at PREBUILD time and
# written into AndroidManifest.xml — deliberately NOT prefixed EXPO_PUBLIC_,
# which would inline it into the JS bundle for no benefit. Re-run
# `npx expo prebuild` after setting this; frontend/android/ is gitignored, so
# the manifest is regenerated rather than committed.
#
# iOS does not need a key: no PROVIDER_GOOGLE anywhere, so iOS uses Apple Maps.
# Geocoding does not need one either — utils/geocode.ts uses Nominatim/OSM.
#
# This key ships inside the APK and is extractable. Keeping it out of git is
# hygiene, not security. The real control is the restriction in Cloud Console:
# Application restriction -> Android apps -> package com.spoton.app PLUS the
# SHA-1 of every signing cert. Debug and release SHA-1s differ, and under Play
# App Signing Google re-signs the app — so register the fingerprint from Play
# Console, not your local keystore, or the Play build's map renders blank with
# no error.
GOOGLE_MAPS_ANDROID_API_KEY=
