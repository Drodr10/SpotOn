SUPABASE_URL=
SUPABASE_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
BACKEND_URL=YourNgrokUrl
# Signing secret from Stripe Dashboard -> Developers -> Webhooks (endpoint: /api/stripe/webhook)
STRIPE_WEBHOOK_SECRET=
# Shared secret required in the X-Sweep-Secret header for the manual/backup
# trigger POST /api/stripe/run-payout-sweep
SWEEP_SECRET=
# In-process APScheduler payout sweep (primary trigger). On by default; must run
# in exactly ONE process — set to false on all but one instance if you scale out.
ENABLE_SWEEP_SCHEDULER=true
SWEEP_INTERVAL_SECONDS=900
