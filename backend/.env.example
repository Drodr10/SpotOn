SUPABASE_URL=
SUPABASE_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
BACKEND_URL=YourNgrokUrl
# Signing secret from Stripe Dashboard -> Developers -> Webhooks (endpoint: /api/stripe/webhook)
STRIPE_WEBHOOK_SECRET=
# Shared secret required in the X-Sweep-Secret header to trigger /api/stripe/run-payout-sweep
SWEEP_SECRET=
# Optional fallback scheduler (use only if Supabase pg_cron is unavailable)
ENABLE_SWEEP_SCHEDULER=false
SWEEP_INTERVAL_SECONDS=900
